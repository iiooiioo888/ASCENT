# 複製到 apps/api/.env（pnpm setup:env 會自動處理）。Prisma 在 apps/api 目錄執行。
#
# 工程 MVP 預設：SQLite（無 Docker 可玩）
DATABASE_URL="file:./dev.db"
#
# 目標主庫 PostgreSQL（先 pnpm db:up，並把 prisma/schema.prisma provider 改為 postgresql）：
# DATABASE_URL="postgresql://ascent:ascent@localhost:5432/ascent"
#
PORT=3000
WEB_ORIGIN=http://localhost:5173
# 正式環境必填。本機未設定時 API 用開發用簽章，不要拿到正式機。
# AUTH_JWT_SECRET="change-me"
