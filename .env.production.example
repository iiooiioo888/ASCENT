# Copy to .env.production on the VPS (never commit real secrets).
#   cp .env.production.example .env.production

# --- PostgreSQL (docker-compose service: postgres) ---
POSTGRES_USER=ascent
POSTGRES_PASSWORD=change-me-use-a-long-random-string
POSTGRES_DB=ascent

# --- Published HTTP port (nginx / web container) ---
# On a VPS you will usually set PUBLIC_WEB_ORIGIN to http://YOUR_DOMAIN_OR_IP:HTTP_PORT
HTTP_PORT=8080

# --- API (internal; exposed only on the Compose network) ---
API_PORT=3000

# Browser origin for CORS (must match how players open the game in the browser).
# Examples:
#   http://203.0.113.10:8080
#   https://ascent.example.com
PUBLIC_WEB_ORIGIN=http://localhost:8080
