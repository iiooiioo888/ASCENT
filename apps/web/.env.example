# U6: set to `false`, `0`, `off`, or `FALSE` to hide the resource-depletion banner (default: on).
# VITE_FEATURE_SHOW_DEPLETION_EMPTY_STATE=false

# U12: silo building card layout — `simplified` (default) or `legacy` (full card chrome; production buttons still hidden).
# VITE_FEATURE_SILO_CARD_MODE=simplified

# P-D3: show empty plot to place silo — set to `true` to restore legacy placement (default: off).
# VITE_FEATURE_SHOW_SILO_PLACEMENT=false
